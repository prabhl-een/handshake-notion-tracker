# Copy this file to .env and fill in your own values. Never commit .env.

# Create an integration at https://www.notion.so/my-integrations
# and copy its "Internal Integration Secret"
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Open your Job Application Tracker database in Notion, click "..." > Copy link,
# and pull the 32-character ID out of the URL (the part before the "?v=")
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
